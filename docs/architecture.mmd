flowchart TD
    U([User question + thread_id]) --> C{"Classifier<br/>(LLM call)"}
    C -->|COURSES| A1[Courses agent]
    C -->|PROGRAMMING| A2[Programming agent]
    C -->|MATHEMATICS| A3[Mathematics agent]
    C -->|ADMINISTRATION| A4[Administration agent]
    C -->|"GENERAL or<br/>unknown label"| A5[General agent]
    C -->|"empty input<br/>or API error"| F[Fallback]
    A1 & A2 & A3 & A4 & A5 --> D{"Tool call<br/>in the reply?"}
    D -->|yes| T["ToolNode: calculator · current_datetime<br/>(handle_tool_errors=True)<br/>↺ result goes back to the agent that called it"]
    D -->|no| R([Final response])
    F --> R
    R -.- M[("MemorySaver: messages<br/>saved per thread_id")]
    classDef agent fill:#eef2ff,stroke:#6366f1;
    classDef tool fill:#ecfdf5,stroke:#059669;
    classDef err fill:#fef2f2,stroke:#dc2626;
    class A1,A2,A3,A4,A5 agent; class T tool; class F err;
